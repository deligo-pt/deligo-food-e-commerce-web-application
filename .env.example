# DeliGo customer web — environment reference
#
# Copy to `.env` and fill in. Every variable the app reads is listed here; if you
# add a new `process.env.*` lookup, add it here in the same commit or the next
# person to deploy will not know it exists.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time. That
# means two things: they are public (never put a secret behind that prefix), and
# changing one requires a rebuild, not just a restart.

# ─── Backend ─────────────────────────────────────────────────────────────────
# Required. No default — the app cannot talk to anything without it.
NEXT_PUBLIC_API_BASE_URL="https://api-test-food.deligo.pt/api/v1"

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Required. Used by address entry, the order map, and the distance-matrix route.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Firebase Cloud Messaging (push notifications) ───────────────────────────
# All seven are required for push to work. If any is missing, `requestFCMToken()`
# returns nothing, `fcmToken` is sent as "" on login, and the device silently
# never receives notifications — there is no error, so this is easy to miss.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ─── Social login ────────────────────────────────────────────────────────────
# Both IDs are public identifiers — the browser SDKs need them, and they ship in
# the bundle by design. Neither is a secret. The Facebook *app secret* is a
# secret and belongs on the server only; it must never appear in this file.
#
# There are no on/off switches for these features: the login page always shows
# the WhatsApp option and both provider buttons. Each requires setup outside
# this file, and without it the customer gets an error rather than nothing:
#
#   Google    — this environment's exact origin (scheme, host, port) must be
#               under Authorized JavaScript origins on the OAuth client, and
#               this client ID must be in the backend's GOOGLE_OAUTH_CLIENT_IDS.
#               Miss the first and the button never renders; miss the second and
#               every sign-in returns INVALID_SOCIAL_TOKEN.
#   Facebook  — this domain must be in App Domains and Valid OAuth Redirect
#               URIs, `email` must be on the login use case, and while the app
#               is in Development mode only accounts under App roles can log in.
#   WhatsApp  — needs BULKGATE_WHATSAPP_SENDER_ID on the SERVER, not here.
#               Until it is set, choosing WhatsApp always fails.
#
# The Google value must be the **Web application** client ID, not Android/iOS.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=""
NEXT_PUBLIC_FACEBOOK_APP_ID=""
